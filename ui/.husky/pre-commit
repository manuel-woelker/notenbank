#!/usr/bin/env sh

# Navigate to project root, then to ui directory
cd "$(git rev-parse --show-toplevel)/ui"

# Run linting, formatting, and type checking
echo "Running ESLint..."
../tool-tool.exe pnpm run lint || exit 1

echo "Running Prettier..."
../tool-tool.exe pnpm run format:check || exit 1

echo "Running TypeScript type check..."
../tool-tool.exe pnpm run typecheck || exit 1

echo "All checks passed!"
